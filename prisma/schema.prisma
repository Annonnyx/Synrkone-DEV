generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ROLES
// =====================

enum UserRole {
  USER       // Utilisateur standard — voit les fichiers du projet, pas le code
  DEV        // Développeur — accès au code + sa propre "Ma Box"
  ADMIN      // Admin — voit toutes les boxes + tous les fichiers, peut modifier
  OWNER      // Owner — tout accès, peut tout modifier/supprimer
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================
// USERS
// =====================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  role          UserRole @default(USER)
  discordId     String?  @unique

  // Relations NextAuth
  accounts Account[]
  sessions Session[]

  // Box personnelle (uniquement pour DEV+)
  boxId String? @unique
  box   Box?    @relation(fields: [boxId], references: [id])

  // Fichiers uploadés
  uploadedFiles File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// =====================
// BOXES (Drive personnel)
// =====================

model Box {
  id        String @id @default(cuid())
  name      String
  path      String @unique // Chemin sur le VPS : /var/lib/synkrone/storage/boxes/{userId}
  maxSizeMb Int    @default(500) // Quota en MB

  // Propriétaire (un utilisateur = une box max)
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fichiers dans la box
  files File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("boxes")
}

// =====================
// FICHIERS
// =====================

enum FileLocation {
  PROJECT   // Fichier du projet/bot (visible par tous les membres du projet)
  BOX       // Fichier dans la box personnelle d'un dev
  VPS_ROOT  // Fichier racine du VPS (admin/owner uniquement)
}

model File {
  id        String       @id @default(cuid())
  name      String
  path      String       // Chemin réel sur le VPS
  mimeType  String       @default("application/octet-stream")
  sizeBytes BigInt       @default(0)
  location  FileLocation @default(PROJECT)

  // Qui a uploadé
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  // Box (si location = BOX)
  boxId String?
  box   Box?  @relation(fields: [boxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("files")
}
