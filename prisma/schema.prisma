generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ROLES
// =====================

enum UserRole {
  USER       // Utilisateur standard — voit les fichiers du projet, pas le code
  DEV        // Développeur — accès au code + sa propre "Ma Box"
  ADMIN      // Admin — voit toutes les boxes + tous les fichiers, peut modifier
  OWNER      // Owner — tout accès, peut tout modifier/supprimer
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================
// USERS
// =====================

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  role          UserRole @default(USER)
  discordId     String?  @unique
  discordRoles  Json     @default("[]")   // IDs des rôles Discord sur le serveur Synkrone
  isOnSynkroneServer Boolean @default(false) // Est membre du serveur Discord Synkrone

  // Relations NextAuth
  accounts Account[]
  sessions Session[]

  // Box personnelle (uniquement pour DEV+)
  box Box? @relation("UserBox")

  // Fichiers uploadés
  uploadedFiles File[]
  
  // Bots créés par l'utilisateur
  bots          Bot[]
  
  // Boxes partagées avec l'utilisateur
  sharedBoxes BoxShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// =====================
// BOXES (Drive personnel)
// =====================

model Box {
  id        String @id @default(cuid())
  name      String
  path      String @unique // Chemin sur le VPS : /var/lib/synkrone/storage/boxes/{userId}
  maxSizeMb Int    @default(500) // Quota en MB

  // Propriétaire (un utilisateur = une box max)
  userId String @unique
  user   User   @relation("UserBox", fields: [userId], references: [id])

  // Fichiers dans la box
  files File[]

  // Partages de la box avec d'autres utilisateurs
  shares BoxShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("boxes")
}

// =====================
// FICHIERS
// =====================

enum FileLocation {
  PROJECT   // Fichier du projet/bot (visible par tous les membres du projet)
  BOX       // Fichier dans la box personnelle d'un dev
  VPS_ROOT  // Fichier racine du VPS (admin/owner uniquement)
}

model File {
  id        String       @id @default(cuid())
  name      String
  path      String       // Chemin réel sur le VPS
  mimeType  String       @default("application/octet-stream")
  sizeBytes BigInt       @default(0)
  location  FileLocation @default(PROJECT)

  // Qui a uploadé
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  // Box (si location = BOX)
  boxId String?
  box   Box?  @relation(fields: [boxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("files")
}

// =====================
// BOX SHARES (Partage de boxes)
// =====================

model BoxShare {
  id     String @id @default(cuid())
  boxId  String
  userId String
  
  box Box @relation(fields: [boxId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Permissions
  canRead  Boolean @default(true)   // Peut voir et télécharger
  canWrite Boolean @default(false) // Peut uploader/modifier/supprimer
  
  createdAt DateTime @default(now())
  
  @@unique([boxId, userId])
  @@map("box_shares")
}

// =====================
// MODULES (Bot modules)
// =====================

enum ModuleCategory {
  MANAGEMENT
  MODERATION
  UTILITY
  FUN
  ECONOMY
  MUSIC
  AI
  WEB
  CUSTOM
}

model ModuleDef {
  id          String          @id @default(cuid())
  moduleId    String          @unique // "autorole", "generation", etc.
  name        String
  description String
  icon        String          // Nom de l'icône Lucide
  premium     Boolean         @default(false)
  enabled     Boolean         @default(true)
  category    ModuleCategory
  pointCost   Int             @default(1) // Coût en Krônes
  
  // Relations
  instances   ModuleInstance[]
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("modules")
}

model ModuleInstance {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  config    Json?    // Configuration spécifique du module pour ce bot
  
  // Relations
  moduleId  String
  module    ModuleDef @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, botId]) // Un module unique par bot
  @@map("module_instances")
}

// =====================
// BOTS
// =====================

model Bot {
  id          String   @id @default(cuid())
  name        String
  token       String?  // Encrypted token storage
  hosting     String   @default("synkrone") // "synkrone" | "self"
  status      String   @default("offline") // "online" | "offline" | "error"
  prefix      String?  // Préfixe choisi par l'utilisateur (!, ?, &, etc.)
  useSlashCommands Boolean @default(false) // /commandes (premium uniquement)
  
  // Krônes / Points system
  maxKr       Int      @default(30) // Points maximum selon le plan
  usedKr      Int      @default(0)  // Points utilisés
  
  // Relations
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  modules     ModuleInstance[]
  stats       BotStats?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bots")
}

model BotStats {
  id                String   @id @default(cuid())
  
  // Métriques principales
  servers           Int      @default(0)
  users             Int      @default(0)
  commandsToday     Int      @default(0)
  totalCommands     Int      @default(0)
  
  // Performance
  uptime            String   @default("0%")
  latency           String   @default("0ms")
  memory            String   @default("0 MB")
  cpu               String   @default("0%")
  
  // Activité
  messagesProcessed Int      @default(0)
  errors            Int      @default(0)
  lastRestart       String   @default("Jamais")
  
  // Top commandes (stocké comme JSON)
  topCommands       Json     @default("[]")
  dailyActivity     Json     @default("[]")
  
  // Relations
  botId             String   @unique
  bot               Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  
  updatedAt         DateTime @updatedAt

  @@map("bot_stats")
}
